# Postgres connection string (Neon: use the *pooled* connection string). POSTGRES_URL is also accepted.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Login for the web app
DEMO_USERNAME=demo@roomie.app
DEMO_PASSWORD=Roomie@2026
# Long random string used to sign session cookies
AUTH_SECRET=replace-with-64-random-hex-chars
# Secret that goes in the MCP URL: https://<app>/api/mcp/<MCP_ACCESS_KEY>
MCP_ACCESS_KEY=replace-with-40-random-hex-chars
# Optional: public base URL used in links returned to Claude (auto-detected if unset)
APP_URL=
